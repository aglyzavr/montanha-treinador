# Copy this file to ".env" and fill in your real values. NEVER commit .env.

# --- Garmin Connect ---
# Used once by scripts/setup_garmin_login.py to create a cached token,
# then reused silently on every run.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
# Where the login token is cached (default is fine):
GARMIN_TOKENSTORE=~/.garminconnect

# --- Telegram (primary delivery) ---
# Get the token from @BotFather; get the chat id from getUpdates (see README).
TELEGRAM_TOKEN=123456789:ABCdef_your_bot_token_here
TELEGRAM_CHAT_ID=123456789

# --- Email (optional, for the weekly review). Leave blank to disable. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
