# Copy this file to ".env" and fill in your real values. NEVER commit .env.

# --- Garmin Connect (official Personal API) ---
# Create a key at https://connect.garmin.com/app/settings/personalApiToken
# (choose 1 year; it is shown only once), then check it with
# scripts/setup_garmin_key.py. Garmin emails you a week before it expires.
GARMIN_API_KEY=your-garmin-personal-api-key

# --- Telegram (primary delivery) ---
# Get the token from @BotFather; get the chat id from getUpdates (see README).
TELEGRAM_TOKEN=123456789:ABCdef_your_bot_token_here
TELEGRAM_CHAT_ID=123456789

# --- Email (optional, for the weekly review). Leave blank to disable. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
