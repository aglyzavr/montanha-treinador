<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly review, Sundays at 07:00. Weekday 0 = Sunday.
  Replace __PROJECT_DIR__ with the absolute path to montanha-coach.
  Install:
    cp scripts/com.montanha.coach.weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.montanha.coach.weekly.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.montanha.coach.weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd __PROJECT_DIR__ &amp;&amp; caffeinate -i .venv/bin/python -m src.weekly</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
